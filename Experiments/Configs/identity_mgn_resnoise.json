{
  "metadata": "DataProcessing/metadata.json",
  "output": "Experiments/Results",
  "seed": 42,
  "device": "cuda",
  "cpu_threads": 4,
  "validation_fraction": 0.2,
  "batch_size": 2,
  "workers": 0,
  "preprocessing_batch_size": 64,
  "compressor": {
    "name": "identity"
  },
  "model": {
    "name": "meshgraphnet",
    "coordinates": "Data/coordinates.npy",
    "edges": "Data/edges.npy",
    "fields": 11,
    "dim": 128,
    "hidden": 128,
    "passes": 8,
    "lr": 0.001,
    "epochs": 100,
    "patience": 15,
    "residual": true,
    "noise_std": 0.01
  },
  "logging": {
    "wandb": {
      "mode": "offline",
      "project": "rom-flamebench",
      "entity": "FireMark"
    }
  },
  "evaluation": {
    "heat_release": true,
    "initialization": "steady",
    "gain_phase_start": 0.5,
    "save_predictions": false
  },
  "Nx": 4,
  "Ni": 4
}