{
  "metadata": "Data/metadata.json",
  "output": "Experiments/Results",
  "seed": 42,
  "device": "cuda",
  "cpu_threads": 4,
  "validation_fraction": 0.2,
  "batch_size": 8,
  "workers": 0,
  "preprocessing_batch_size": 64,
  "compressor": {
    "name": "identity"
  },
  "model": {
    "name": "deeponet",
    "coordinates": "Data/coordinates.npy",
    "fields": 11,
    "sensors": 2048,
    "p": 64,
    "hidden": 256,
    "branch_layers": 3,
    "trunk_layers": 3,
    "lr": 0.001,
    "epochs": 50,
    "patience": 10,
    "unroll_steps": 16,
    "unroll_grad": "none"
  },
  "logging": {
    "wandb": {
      "mode": "offline",
      "project": "rom-flamebench",
      "entity": "FireMark"
    }
  },
  "evaluation": {
    "heat_release": true,
    "initialization": "steady",
    "gain_phase_start": 0.5,
    "save_predictions": false
  },
  "Nx": 4,
  "Ni": 4,
  "validation_window": 500
}