{
  "metadata": "Data/metadata.json",
  "output": "Experiments/Results",
  "seed": 42,
  "device": "cuda",
  "cpu_threads": 4,
  "validation_fraction": 0.3,
  "blocks": 20,
  "K_eval": 150,
  "batch_size": 8,
  "joint_batch_size": 8,
  "workers": 0,
  "in_memory": false,
  "preprocessing_batch_size": 256,
  "compressor": {
    "name": "identity"
  },
  "dataset": {
    "Nx": 9,
    "Ni": 4,
    "horizon": 10
  },
  "forecaster": {
    "name": "fno",
    "grid": "Data/grid_indices.npz",
    "layers": 4,
    "width": 32,
    "modes": [
      12,
      12
    ],
    "projection": [
      128
    ],
    "padding": 9,
    "activation": "gelu",
    "coordinates": true,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "epochs": 60,
    "patience": 10,
    "rollout_weight": 0.5
  },
  "logging": {
    "wandb": {
      "mode": "offline",
      "project": "rom-flamebench",
      "entity": "FireMark"
    }
  },
  "evaluation": {
    "heat_release": true,
    "initialization": "steady",
    "gain_phase_start": 0.5,
    "save_predictions": false
  }
}
